---
import Seo from '../components/Seo.astro';
import { profile, projects } from '../data/content';
import { contributions } from '../data/contributions';
import CaseStudy from '../components/CaseStudy';
import { resume } from '../data/resume';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title="Aayan Amir — Projects and experience"
      description="Software projects, engineering decisions and contributions by Aayan Amir. Open to backend and full-stack internships, junior roles and freelance work."
    />
  </head>
  <body class="reading-page">
    <main>
      <a href="/">Return to the workshop</a>
      <p class="eyebrow">The readable edition</p>
      <h1>{profile.name}</h1>
      <p class="lead">
        Software developer building practical tools that make everyday work
        easier.
      </p>
      <p>
        Seeking backend and full-stack internships and junior roles. Open to
        freelance conversations.
      </p>
      <p>
        <a href={resume.url} download={resume.filename}>
          Download résumé (PDF)
        </a>
      </p>
      <h2 id="selected-work">Selected work</h2>
      {projects.map((project) => (
        <article id={project.id}>
          <p class="eyebrow">{project.category}</p>
          <h3>
            <a href={`/work/${project.id}/`}>{project.name}</a>
          </h3>
          <CaseStudy project={project} level={4} />
          {project.url && <a href={project.url}>Visit live project</a>}{' '}
          {project.source && <a href={project.source}>Source code</a>}
        </article>
      ))}
      <h2 id="experience">Contributions</h2>
      <p>Backend Developer (Contract) · January–September 2026</p>
      {contributions.map((item) => (
        <article>
          <h3>{item.title}</h3>
          <p>
            {item.before} {item.change}
          </p>
          <p>
            <strong>{item.result}</strong>
          </p>
        </article>
      ))}
      <h2>How I work</h2>
      <p>
        I start with repetitive tasks and look for a practical way to make them
        easier. I use AI tools to help with development, review the output, and
        check what I ship.
      </p>
      <h2>Contact</h2>
      <p>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </p>
      <a href={profile.github}>GitHub</a>
      <aside id="credits">
        <h2>Scene credits</h2>
        <p>
          Planetary textures by{' '}
          <a href="https://www.solarsystemscope.com/textures/">
            Solar System Scope
          </a>
          , licensed under{' '}
          <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
          Earth map distributed with the{' '}
          <a href="https://github.com/mrdoob/three.js/blob/dev/examples/textures/planets/earth_day_4096.jpg">
            Three.js examples
          </a>
          ; the default Earth map is resized to 2048 × 1024 for lower texture
          memory. Other scene geometry and procedural materials are original.
          Additional map provenance is recorded in{' '}
          <a href="/planets/ATTRIBUTION.txt">planet texture attribution</a>.
        </p>
      </aside>
    </main>
  </body>
</html>
