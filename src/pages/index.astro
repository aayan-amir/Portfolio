---
import Seo from '../components/Seo.astro';
import Workshop from '../components/Workshop';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e8e4da" />
    <Seo
      title="Aayan Amir — Software developer"
      description="Backend and full-stack developer in Karachi. Explore NoClash, Student Portal and NoTerm, practical engineering decisions, experience and resume."
    />
  </head>
  <body>
    <Workshop client:load />
    <noscript>
      <div class="no-script">
        The workshop’s interactive view needs JavaScript.{' '}
        <a href="/read">Read the portfolio</a> for all projects and contact
        information.
      </div>
    </noscript>
  </body>
</html>
