---
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const origin = Astro.site;
const canonical = origin ? new URL(Astro.url.pathname, origin) : undefined;
const image = origin ? new URL('/social-preview.png', origin) : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta
  name="robots"
  content={noindex || !origin ? 'noindex, follow' : 'index, follow'}
/>
{canonical && !noindex && <link rel="canonical" href={canonical} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Aayan Amir" />
{canonical && <meta property="og:url" content={canonical} />}
{image && (
  <>
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Aayan Amir — backend and full-stack software developer. NoClash, Student Portal and NoTerm."
    />
  </>
)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={image} />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
