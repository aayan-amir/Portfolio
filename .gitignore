# Dependencies and Astro/Vite build caches
node_modules/
/dist/
/.astro/
/.astro-seed/
/.cache/

# Environment files; keep safe example configuration in version control
.env*
!.env.example
!.env.*.example

# Local hosting state
/.vercel/
/.netlify/
/.wrangler/

# Generated verification and document output
/output/
/coverage/
/.nyc_output/
/playwright-report/
/test-results/
/blob-report/
/tmp/
/temp/
*.tsbuildinfo

# Logs and local process files
*.log
*.pid
*.pid.lock

# OS and editor-local files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vs/
*.suo
*.user
*.swp
*.swo
*~

# Blender backup files; original .blend models remain trackable
*.blend[0-9]
*.blend[0-9][0-9]

# Public résumé PDFs, scene assets, source art, docs and package-lock.json
# are intentional project files and must remain trackable.
