# Dependencies and Astro/Vite build caches
node_modules/
/dist/
/.astro/
/.astro-seed/
/.cache/
/.vite/

# Environment files; keep safe example configuration in version control
.env*
!.env.example
!.env.*.example

# Local hosting state
/.vercel/
/.netlify/
/.wrangler/

# Generated verification and document output
/output/
/coverage/
/.nyc_output/
/playwright-report/
/test-results/
/blob-report/
/tmp/
/temp/
*.tsbuildinfo

# Standalone Lighthouse reports and local performance captures
# Audits normally live in /output/; cover CLI defaults in the repo root too.
/.lighthouseci/
/*.report.html
/*.report.json
/*.trace.json
/*.devtoolslog.json
/*.cpuprofile
/*.heapprofile
/*.heapsnapshot

# Downloaded npm inspection archives and unprocessed scene exports
/*.tgz
/static-cabin.croom

# Python helper caches
__pycache__/
*.py[cod]

# Logs and local process files
*.log
*.pid
*.pid.lock

# OS and editor-local files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vs/
*.suo
*.user
*.swp
*.swo
*~

# Blender backup files; original .blend models remain trackable
*.blend[0-9]
*.blend[0-9][0-9]

# Local Markdown notes and planning/review documents (all directories)
*.[mM][dD]
*.[mM][aA][rR][kK][dD][oO][wW][nN]

# Public résumé PDFs, scene assets, source art and package-lock.json
# are intentional project files and remain trackable.
*.md
